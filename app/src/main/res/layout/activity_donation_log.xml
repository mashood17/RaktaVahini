<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_grey">

    <!-- Red toolbar -->
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="80dp" android:background="@color/blood_red"
        android:gravity="center_vertical" android:paddingStart="16dp"
        android:paddingTop="24dp">
        <TextView android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋 Donation History"
            android:textColor="@color/white"
            android:textSize="22sp" android:textStyle="bold"/>
    </LinearLayout>

    <!-- Summary card: Total | Next Eligible -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="4dp">
        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" android:padding="16dp">

            <LinearLayout android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvTotalDonations"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="@color/blood_red"
                    android:textSize="36sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Total Donations"
                    android:textColor="@color/medium_grey" android:textSize="12sp"/>
                <TextView
                    android:id="@+id/tvLogEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No donations yet"
                    android:layout_gravity="center"/>
            </LinearLayout>

            <View android:layout_width="1dp" android:layout_height="match_parent"
                android:background="@color/divider_grey"
                android:layout_marginStart="8dp" android:layout_marginEnd="8dp"/>

            <LinearLayout android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                android:orientation="vertical" android:gravity="center">
                <TextView android:id="@+id/tvNextEligible"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Now!" android:textColor="@color/eligible_green"
                    android:textSize="22sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Next Eligible"
                    android:textColor="@color/medium_grey" android:textSize="12sp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Section label -->
    <TextView android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Donation History"
        android:textColor="@color/dark_grey" android:textStyle="bold"
        android:textSize="16sp" android:paddingStart="16dp"
        android:paddingBottom="8dp"/>

    <!-- Donation list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDonationLog"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp" android:paddingEnd="16dp"
        android:clipToPadding="false"/>

    <!-- Empty state -->
    <TextView android:id="@+id/tvEmptyLog"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="No donations logged yet."
        android:textColor="@color/medium_grey" android:textSize="15sp"
        android:gravity="center" android:padding="32dp"
        android:visibility="gone"/>

</LinearLayout>
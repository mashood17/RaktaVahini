<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="10dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top row: badge + name + city + status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <!-- Blood group red badge -->
            <TextView
                android:id="@+id/tvBloodGroupBadge"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@color/blood_red"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginEnd="12dp" />

            <!-- Name + city -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tvDonorName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/dark_grey"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tvDonorCity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/medium_grey"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Green available badge -->
            <TextView
                android:id="@+id/tvAvailableBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● Available"
                android:textColor="@color/eligible_green"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Call button -->
        <Button
            android:id="@+id/btnCallDonor"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📞  Call Donor"
            android:textColor="@color/white"
            android:backgroundTint="@color/blood_red"
            android:textSize="15sp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
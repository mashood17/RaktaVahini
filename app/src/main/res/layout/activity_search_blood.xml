<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_grey">

    <!-- Red toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/blood_red"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍 Find Blood"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Blood group selector card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select Blood Group Needed"
                android:textColor="@color/dark_grey"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp" />
            <Spinner
                android:id="@+id/spinnerSearchBloodGroup"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@color/background_grey"
                android:paddingStart="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Result count / empty message -->
    <TextView
        android:id="@+id/tvResultStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select a blood group to find donors"
        android:textColor="@color/medium_grey"
        android:textSize="14sp"
        android:gravity="center"
        android:paddingBottom="8dp" />

    <!-- Donor RecyclerView list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerDonors"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:clipToPadding="false" />

</LinearLayout>